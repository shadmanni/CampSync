{
  "name": "campussync-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,yellow\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "client": "npm run dev --prefix client",
    "server": "npm start --prefix server",
    "app": "npm start --prefix app",
    "db:setup": "npm run db:setup --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
