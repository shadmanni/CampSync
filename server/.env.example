# CampusSync Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=campussync_super_secret_jwt_key_2026

# PostgreSQL / Supabase Connection String
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006,https://campsync.vercel.app

# Transactional email (recommended): create a Resend API key and verify a
# sending domain. The sender must use that verified domain.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=CampusSync <verify@auth.your-domain.com>

# Optional SMTP fallback (Brevo, Mailgun, SES, etc.; Gmail is not required)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Development only. Never enable this in a deployed environment.
ALLOW_SIMULATED_OTP=false
ALLOW_IN_MEMORY_DB=false
